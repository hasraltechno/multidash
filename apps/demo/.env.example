# Copy to .env.local for local development, or set these in your host's dashboard (e.g. Vercel).

# Public URL of the site, used for Open Graph and canonical URLs.
# Optional on Vercel production — falls back to productionUrl in lib/site.ts.
NEXT_PUBLIC_SITE_URL=

# Pro waitlist — configure ONE of the options below.
# Option A: Resend (https://resend.com) — each signup becomes a contact.
RESEND_API_KEY=
RESEND_SEGMENT_ID=
# Option B: any webhook that accepts JSON { email, source, createdAt } (Zapier, Make, n8n, Google Apps Script, ...).
WAITLIST_WEBHOOK_URL=
